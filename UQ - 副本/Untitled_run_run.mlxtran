<DATAFILE>

[FILEINFO]
file='YCLPPK3.csv'
delimiter = comma
header={ID, TIME, DOSE, CV, AGE, AST, CALCIUMNON_IONIZED, CHLORIDE_SERUM_, CK_CPK_, CrCL, DIFFERENTIAL_ATYPS, DIFFERENTIAL_BANDS, DRINKING, GENDER, GLUCOSE_WHOLEBLOOD_, POTASSIUM_SERUM_, TROPONIN_T, CREATININE_SERUM_, WEIGHT}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
DOSE = {use=amount}
CV = {use=observation, type=continuous}
AGE = {use=covariate, type=continuous}
AST = {use=covariate, type=continuous}
CALCIUMNON_IONIZED = {use=covariate, type=continuous}
CHLORIDE_SERUM_ = {use=covariate, type=continuous}
CK_CPK_ = {use=covariate, type=continuous}
CrCL = {use=covariate, type=continuous}
DIFFERENTIAL_ATYPS = {use=covariate, type=continuous}
DIFFERENTIAL_BANDS = {use=covariate, type=continuous}
DRINKING = {use=covariate, type=categorical}
GENDER = {use=covariate, type=categorical}
GLUCOSE_WHOLEBLOOD_ = {use=covariate, type=continuous}
POTASSIUM_SERUM_ = {use=covariate, type=continuous}
TROPONIN_T = {use=covariate, type=continuous}
CREATININE_SERUM_ = {use=covariate, type=continuous}
WEIGHT = {use=covariate, type=continuous}

[SETTINGS]
dataType = {'CV'=plasma}

<MODEL>

[COVARIATE]
input = {AGE, AST, CALCIUMNON_IONIZED, CHLORIDE_SERUM_, CK_CPK_, CREATININE_SERUM_, CrCL, DIFFERENTIAL_ATYPS, DIFFERENTIAL_BANDS, GLUCOSE_WHOLEBLOOD_, POTASSIUM_SERUM_, TROPONIN_T, WEIGHT, DRINKING, GENDER}

DRINKING = {type=categorical, categories={'0', '1'}}
GENDER = {type=categorical, categories={'0', '1'}}

[INDIVIDUAL]
input = {Cl_pop, omega_Cl, V_pop, omega_V, CrCL, beta_Cl_CrCL, DIFFERENTIAL_ATYPS, beta_Cl_DIFFERENTIAL_ATYPS, GENDER, beta_V_GENDER_1, WEIGHT, beta_Cl_WEIGHT}

GENDER = {type=categorical, categories={'0', '1'}}

DEFINITION:
Cl = {distribution=logNormal, typical=Cl_pop, covariate={CrCL, DIFFERENTIAL_ATYPS, WEIGHT}, coefficient={beta_Cl_CrCL, beta_Cl_DIFFERENTIAL_ATYPS, beta_Cl_WEIGHT}, sd=omega_Cl}
V = {distribution=logNormal, typical=V_pop, covariate=GENDER, coefficient={0, beta_V_GENDER_1}, sd=omega_V}

[LONGITUDINAL]
input = {a, b}

file = 'lib:bolus_1cpt_VCl.txt'

DEFINITION:
CV = {distribution=normal, prediction=Cc, errorModel=combined2(a, b)}

<FIT>
data = 'CV'
model = CV

<PARAMETER>
Cl_pop = {value=28.2, method=MLE}
V_pop = {value=60.92, method=MLE}
a = {value=1, method=MLE}
b = {value=0.3, method=MLE}
beta_Cl_CrCL = {value=0, method=MLE}
beta_Cl_DIFFERENTIAL_ATYPS = {value=0, method=MLE}
beta_Cl_WEIGHT = {value=0, method=MLE}
beta_V_GENDER_1 = {value=0, method=MLE}
c = {value=1, method=FIXED}
omega_Cl = {value=1, method=MLE}
omega_V = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(run = false,method = Linearization)
logLikelihood(method = Linearization)
plotResult(run = false,method = {indfits, parameterdistribution, covariancemodeldiagnosis, covariatemodeldiagnosis, obspred, vpc, residualsscatter, residualsdistribution, randomeffects, saemresults })

[SETTINGS]
GLOBAL:
exportpath = 'Untitled_run_run'

